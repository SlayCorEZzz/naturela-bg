# Copy to .env for local development, and add the same variables in your host's
# project settings (Vercel: Settings -> Environment Variables).
# These are the Supabase publishable keys — safe for the browser, but keep the
# real .env out of git.
SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
